# Skeleton of cuad's systemd user unit: the computer-use daemon. It holds a Wayland connection
# (capture of one leased window, the lease protocol), an EIS socket (the agent's input), the
# accessibility bus, and talks D-Bus to the router, inferd and memoryd. It holds no files and
# no network. Each sandbox line says what it protects. Computer use is off by default
# (`cua.enabled`): the unit may be installed and idle.
#
# How the settings reach the daemon: cuad reads `cua/settings.toml` from `$XDG_CONFIG_HOME`
# (under the person's home), then from each of `$XDG_CONFIG_DIRS` (`/etc/xdg` by default). The
# drop-in (cuad.service.d/sandbox.conf) hides the home folder (`ProtectHome=tmpfs`) and binds
# back only `$XDG_CONFIG_HOME/cua`, read-only, so the file the Settings app writes is read and
# watched; the system-wide `/etc/xdg/cua/settings.toml` (readable: `ProtectSystem=strict` only
# forbids writes) applies when the person has none. A file that exists and cannot be read is logged at start
# and on every change ("settings: <path>: could not be read"), not skipped silently. Until a
# file lists an app, no app is on (`cua.apps` starts empty), so an installed unit with no
# settings file does nothing.
#
# Who may call the daemon: /etc/quire/cuad-callers.toml (dist/cuad-callers.toml) names the units
# of the router, the planner and the shell. The person's own file under their home is out of
# reach here, which only narrows it: a user file can never give a fixed role anyway.
[Unit]
Description=Quire computer-use daemon (org.quire.Cua1)

[Service]
Type=dbus
BusName=org.quire.Cua1
ExecStart=/usr/libexec/quire/cuad --config /etc/quire/cuad.toml
# No loader variables from the session reach the daemon: porter gives its fixed caller role only
# to a unit that unsets them (applied after the manager environment and Environment=).
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH GIO_EXTRA_MODULES GTK_MODULES GTK_PATH GST_PLUGIN_PATH GST_PLUGIN_SYSTEM_PATH LIBGL_DRIVERS_PATH MESA_LOADER_DRIVER_OVERRIDE __EGL_VENDOR_LIBRARY_DIRS __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH LIBVA_DRIVERS_PATH VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_LAYER_PATH VK_ADD_LAYER_PATH VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE
# A crash is not the end of computer use: systemd starts the daemon again (a run that was in
# flight is lost, and its lease with it). Bus activation also starts it on the next call.
Restart=on-failure
RestartSec=2s
# The compositor to connect to. The fork offers `quire_agent_manager_v1` (casement-protocols/protocols/quire-agent-v1.xml)
# only to the client its security context names as this unit; a stock compositor offers
# ext-image-copy-capture to any client on the session bus.
PassEnvironment=WAYLAND_DISPLAY

# --- Resources ---
# Frames live in memory (a few copies of one window: well under 1 GiB even for an 8K output),
# and a run needs a handful of threads (the bus, capture, the EI connection).
MemoryMax=2G
TasksMax=128

# --- Sandbox ---
# Only Unix sockets: the session bus, the accessibility bus, the Wayland socket, inferd's and
# memoryd's sockets, and the EIS socket the compositor hands over. The rest (no network, no home
# folder, a read-only system, private temporary files, no devices, no kernel surfaces) is
# cuad.service.d/sandbox.conf, which the installer leaves out on a system that refuses private
# namespaces for user units.
RestrictAddressFamilies=AF_UNIX
# No setuid gain, no writable-and-executable memory (no JIT, no injected code).
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
# A narrow syscall set: the system-service baseline, minus privileged and obsolete calls. Frames
# travel in memfds, so memfd_create is named rather than assumed.
SystemCallFilter=@system-service memfd_create
SystemCallFilter=~@privileged @resources @mount @debug @obsolete
SystemCallArchitectures=native
# No capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=
# Files cuad creates are private to it.
UMask=0077

[Install]
WantedBy=default.target
